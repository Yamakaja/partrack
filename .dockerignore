# Version control
#
# NOTE: .git is intentionally NOT excluded — the build derives the version
# (git describe) and generates the embedded changelog (tools/genchangelog) from
# git history inside the backend build stage. Multi-stage keeps it out of the
# final image (the runtime stage only copies the binary).
.gitignore

# Frontend build output (built inside Docker, not from host)
web/dist
web/node_modules

# Go tooling artifacts
*.test
*.out

# Dev config and secrets
config.yaml
config.local.yaml
.env
.env.local
.env.*.local

# Docs and reference material (not needed in image)
doc/
reference_material/
*.md
getting-started.md

# IDE / OS
.vscode
.idea
*.DS_Store
