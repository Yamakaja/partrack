PARTRACK_DB_PASSWORD=change-me
PARTRACK_SESSION_SECRET=change-me
PARTRACK_APP_BASE_URL=http://localhost:8080

# Optional
# PARTRACK_PORT=8080
# Set to false only when serving over plain HTTP (e.g. local testing without TLS);
# otherwise session cookies get the Secure flag and login silently fails.
# PARTRACK_SECURE_COOKIES=true
